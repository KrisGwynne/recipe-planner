# Variable names only, blank values. Real values go in .env (gitignored).

# Postgres (Neon). On Vercel the Neon integration sets it per deployment:
# production's main branch, or a preview's own branch. Every deploy migrates it
# before building, so it's needed at build time (vercel.json). Locally, from
# `vercel env pull` (docs/decisions.md).
DATABASE_URL=

# Auth.js. AUTH_SECRET: generate with `pnpm dlx auth secret` or `openssl rand -base64 33`.
AUTH_SECRET=
# Google OAuth client for this app (not the holiday planner's).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
