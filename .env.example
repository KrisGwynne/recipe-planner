# Variable names only, blank values. Real values go in .env (gitignored).

# Postgres (Neon). Locally a Neon dev branch; on Vercel set by the Neon integration.
DATABASE_URL=

# Auth.js. AUTH_SECRET: generate with `pnpm dlx auth secret` or `openssl rand -base64 33`.
AUTH_SECRET=
# Google OAuth client for this app (not the holiday planner's).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
